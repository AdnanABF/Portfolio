# Copy to .env.local and configure. Never commit real secrets.
# Public site URL (canonical origin for metadata/links).
NEXT_PUBLIC_SITE_URL=https://adnanbinfarook.com

# Portfolio .NET 10 Web API backend URL.
# Local development: http://localhost:5065
# Staging: https://staging-api.adnanbinfarook.com
# Production: https://api.adnanbinfarook.com
NEXT_PUBLIC_API_URL=

# Internal Docker container-to-container backend URL (used by Next.js rewrites in Coolify/Docker).
# Local Docker: http://server:8080
INTERNAL_API_URL=
