# Copy to .env.local and fill in. Never commit real keys.
# (The legacy client/.env with VITE_EMAILJS_* is obsolete — Step 10 moved
# sending server-side. It stays gitignored and will be deleted in Step 12.)

# Required for the contact form (Step 10). Get one at https://resend.com
RESEND_API_KEY=

# Sender identity — must be a verified domain in Resend.
# For adnanbinfarook.com, verify the domain first, then use e.g.:
# RESEND_FROM="Portfolio <hello@adnanbinfarook.com>"
RESEND_FROM=

# Owner inbox for contact notifications. Defaults to adnanabf@gmail.com.
CONTACT_TO_EMAIL=

# Public site URL (canonical origin for metadata/links in emails).
NEXT_PUBLIC_SITE_URL=https://adnanbinfarook.com

# Future Coolify backend API (server/). Leave empty to use built-in
# Next.js Server Actions. Example: https://api.adnanbinfarook.com
NEXT_PUBLIC_API_URL=
