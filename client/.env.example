# Copy to .env.local and fill in. Never commit real keys.
# All EMAILJS_* vars are server-only (no NEXT_PUBLIC_ prefix) — the browser
# never sees them. Values come from your EmailJS dashboard (same account +
# templates the old Vite site used).

# Required for the contact form.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Private Key (EmailJS dashboard → Account → General). Required for
# server-side sending.
EMAILJS_PRIVATE_KEY=

# Auto-reply template sent to the visitor (optional but recommended).
EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Public site URL (canonical origin for metadata/links in emails).
NEXT_PUBLIC_SITE_URL=https://adnanbinfarook.com

# Future Coolify backend API (server/). Leave empty to use built-in
# Next.js Server Actions. Example: https://api.adnanbinfarook.com
NEXT_PUBLIC_API_URL=
