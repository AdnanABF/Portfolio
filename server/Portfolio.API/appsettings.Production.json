{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 2,
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "EnableSwagger": false
}
