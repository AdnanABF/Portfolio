{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=portfolio;Username=postgres;Password=PLACEHOLDER_SET_IN_ENV"
  },
  "Jwt": {
    "Secret": "PLACEHOLDER_JWT_SECRET_MINIMUM_32_CHARACTERS_LONG_OVERRIDE_IN_ENV"
  },
  "Admin": {
    "Email": "admin@example.com",
    "Password": "PLACEHOLDER_STRONG_ADMIN_PASSWORD"
  },
  "R2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "portfolio-media",
    "PublicUrl": "https://media.example.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://staging.adnanbinfarook.com",
      "https://adnanbinfarook.com"
    ]
  },
  "ForwardedHeaders": {
    "ForwardLimit": 2,
    "KnownNetworks": [
      "127.0.0.1/32"
    ],
    "KnownProxies": []
  },
  "EnableSwagger": false,
  "AllowedHosts": "*"
}
