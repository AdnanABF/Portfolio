# Portfolio API: environment variables for a deployment (Coolify, Docker or a .env file).
# Copy the lines you need. Never commit real secrets. A double underscore stands for ":" in a setting
# name, so Resend__ApiKey is the setting Resend:ApiKey. Local development uses appsettings.Development.json
# instead (git-ignored; it overrides the commented defaults in Portfolio.API/appsettings.json).

# --- Required in every deployed environment (staging and production) ----------------------------------------------

# Anything other than "Development" turns on the production checks below.
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL connection.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=portfolio;Username=postgres;Password=YOUR_STRONG_POSTGRES_PASSWORD

# The owner account (SuperAdmin), created on the first start. Required in every environment.
# If Admin__Email changes later, the old owner keeps SuperAdmin unless Admin__DemoteFormerOwners is set (below).
Admin__Email=admin@example.com
Admin__Password=YOUR_STRONG_ADMIN_PASSWORD

# The public address of the website. Used in emailed links (invite, verify email, reset password).
# The API refuses to start without it. Use the matching address per environment.
App__PublicBaseUrl=https://adnanbinfarook.com

# Email through Resend. The API refuses to start without ApiKey, FromAddress, NotifyFromAddress and OwnerEmail.
# Use a separate API key per environment.
Resend__ApiKey=re_YOUR_RESEND_API_KEY
# Sender of the acknowledgement email to visitors (a domain verified in Resend).
Resend__FromAddress=hello@yourdomain.com
# Sender of the notification email to you (Reply-To is set to the visitor).
Resend__NotifyFromAddress=contact@yourdomain.com
# Where notifications are delivered.
Resend__OwnerEmail=you@example.com

# --- Optional ------------------------------------------------------------------------------------------------------

# Display name next to the sender address.
Resend__FromName=Your Name
# Set to false to stop sending the acknowledgement email to visitors.
Resend__SendAutoReply=true
# Text put in front of every email subject. Use "[Staging] " (with the trailing space) on staging.
Resend__SubjectPrefix=

# Folder for uploaded files (photo, CV, images). Defaults to "uploads" inside the container, which is lost on
# redeploy unless that folder is a persistent volume. Point this at a mounted volume.
# Storage__LocalPath=/app/uploads

# The owner's offset from UTC in hours, used for the date in the CV's file name ("Adnan CV 2026-11-17.pdf"). Kuwait is 3.
# Media__CvUtcOffsetHours=3

# How many reverse proxies sit in front of the API, and which networks may set X-Forwarded-For. This decides the
# visitor IP used for rate limits. The website forwards browser calls to the API, so count it:
# Traefik (1) + Next.js forwarding (2) = 2. This assumes Cloudflare is DNS only (grey cloud) for the website and API
# hostnames and the website reaches the API over the internal Docker address (INTERNAL_API_URL). With the Cloudflare
# proxy on (orange cloud) the chain is longer and Traefik must also trust Cloudflare's addresses.
ForwardedHeaders__ForwardLimit=2
ForwardedHeaders__KnownNetworks__0=10.0.0.0/8
ForwardedHeaders__KnownNetworks__1=172.16.0.0/12
ForwardedHeaders__KnownNetworks__2=192.168.0.0/16
ForwardedHeaders__KnownNetworks__3=127.0.0.1/32
# Or list single proxy IPs instead:
# ForwardedHeaders__KnownProxies__0=172.18.0.1

# Browser addresses allowed to call the API directly. The website calls /api on its own address, so this is only a
# safety net; list the website's address.
Cors__AllowedOrigins__0=https://adnanbinfarook.com
# Cors__AllowedOrigins__1=https://staging.adnanbinfarook.com

# Swagger UI / OpenAPI docs. Leave off in production.
EnableSwagger=false

# Port inside the container (already set by the Dockerfile).
# ASPNETCORE_HTTP_PORTS=8080

# --- One-time switches: set to true for ONE start, then remove -------------------------------------------------------

# Demote a former owner to Admin after you changed Admin__Email.
# Admin__DemoteFormerOwners=true

# Force the home page content (experience, education, certifications, skills, home page text, projects) to be
# replaced with the CV data on this start. Unlike a normal replacement, this also removes projects that are not in
# the CV. Normally the replacement only happens when a deploy brings a newer CV version, and then projects you added
# yourself are kept.
# Content__ReplaceWithCvSeed=true
