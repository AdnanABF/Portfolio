# Portfolio .NET 10 API Environment Variables Example
# Copy or set these in your deployment dashboard (e.g. Coolify) or .env file.
# Never commit real secrets to version control.

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# Database Connection (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=portfolio;Username=postgres;Password=YOUR_STRONG_POSTGRES_PASSWORD

# Initial Administrator Credentials (seeded on first boot)
Admin__Email=admin@example.com
Admin__Password=YOUR_STRONG_ADMIN_PASSWORD

# Email (Resend). Required outside Development: the API refuses to start without the first four.
# Use a separate API key per environment (staging, production). Locally, put these in
# appsettings.Development.json instead (git-ignored) and leave ApiKey unset to just log emails
# to the console.
Resend__ApiKey=re_YOUR_RESEND_API_KEY
# Sender of the acknowledgement email to visitors (must be on a domain verified in Resend)
Resend__FromAddress=hello@yourdomain.com
# Sender of the notification email to you (Reply-To is set to the visitor)
Resend__NotifyFromAddress=contact@yourdomain.com
Resend__FromName=Your Name
# Where notifications are delivered
Resend__OwnerEmail=you@gmail.com
# Set to false to stop sending the acknowledgement email to visitors
Resend__SendAutoReply=true
# Put "[Staging] " (with the trailing space) on staging so test emails are easy to spot
Resend__SubjectPrefix=

# Forwarded Headers Configuration
# Set ForwardLimit to the total number of reverse proxies / hops before the container:
# e.g., Cloudflare (1) + Host Traefik/Coolify (2) + Next.js rewrite (3) = 3
ForwardedHeaders__ForwardLimit=2

# KnownNetworks (CIDR notation) - trusted proxy subnets
# Use double-underscore and numeric index for configuration array binding in .NET:
ForwardedHeaders__KnownNetworks__0=10.0.0.0/8
ForwardedHeaders__KnownNetworks__1=172.16.0.0/12
ForwardedHeaders__KnownNetworks__2=192.168.0.0/16
ForwardedHeaders__KnownNetworks__3=127.0.0.1/32

# KnownProxies (Individual IP addresses) - alternatively specify direct proxy IPs
# ForwardedHeaders__KnownProxies__0=172.18.0.1

# Swagger UI / OpenAPI docs (disabled by default in Production)
EnableSwagger=false

# Allowed CORS Origins (for direct API access if not rewrote via same-origin Next.js)
Cors__AllowedOrigins__0=https://adnanbinfarook.com
Cors__AllowedOrigins__1=https://staging.adnanbinfarook.com
